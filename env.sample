# env.sample : Crew AI 도구 생성시 기본적으로 필요한 환경 변수 예시.
# env.sample 을 같은 폴더에 .env 로 복사하여 각자 상황에 맞게  해당 키 값을 설정한 후 build.py 를 사용한다.

# Datadog 조회 설정
DD_API_KEY=
DD_APP_KEY=
DD_SITE=

# DevX liteLLM 계정
DEVX_API_URL=
DEVX_API_KEY=
DEVX_MODEL=
DEVX_TEMPERATURE=0.0

# AWS Bedrock 계정
BEDROCK_MODEL=
BEDROCK_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_TOP_K=1   # 1~5 사이 권장 (작을수록  엄격한 결정성,  항상 최빈 토큰 선택)

# Gemini 계정 (gemini-2.5-flash, gemini-2.5-pro)
GEMINI_MODEL=
GEMINI_API_KEY=

# 모니터링
AGENTOPS_API_KEY=
CREWAI_TRACING_ENABLED=true

# CREW AI 콘솔에서 발급받은 토큰을 환경변수로 추가하면 툴로 사용가능
CREWAI_PLATFORM_INTEGRATION_TOKEN=

# OutLook 설정
OUTLOOK_EMAIL=
OUTLOOK_PASSWORD=

# Gmail 설정 (앱 비밀번호 필요)
GOOGLE_EMAIL=
GOOGLE_PASSWORD=

# Teams Webhook URL 
TEAMS_WEBHOOK_URL=

# AMP Deploy Info
CREWAI_AMP_URL=
CREWAI_AMP_KEY=